# ==== LLM（OpenAI 兼容端点，DeepSeek / Kimi / 智谱 / OpenAI 均可）====
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# 可选：深度思考模型（若使用 deepseek-reasoner，会把 reasoning_content 透传进 session.jsonl）
# OPENAI_MODEL=deepseek-reasoner

# ==== 运行时 ====
# local = 进程级受限沙箱（默认，无需 Docker）
XCPC_SANDBOX_MODE=local
# 单组测试数据的运行超时（秒），run_stress_test 未显式指定时使用
XCPC_TIMEOUT_SEC=2.0
# 记忆目录（默认 ./chat_memory；evals 会覆盖成隔离目录避免污染真实画像）
# XCPC_MEMORY_DIR=chat_memory
# 触发 90% 安全压缩的上下文窗口（默认 128000）
# XCPC_MAX_CONTEXT=128000
# 是否流式输出（1/0）
XCPC_STREAM=1
# LLM 单次请求超时（秒）
XCPC_LLM_TIMEOUT_SEC=180
# 显式指定 C++ 编译器（默认自动探测 g++）
# CXX=g++
